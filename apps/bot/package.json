{
  "name": "@sumirevox/bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/dotenv-cli/cli.js -e ../../.env -- tsx watch src/index.ts",
    "build": "tsc",
    "deploy-commands": "node ./node_modules/dotenv-cli/cli.js -e ../../.env -- tsx src/deploy-commands.ts",
    "test": "vitest run",
    "prisma:generate": "node ./node_modules/dotenv-cli/cli.js -e ../../.env -- prisma generate",
    "prisma:migrate:dev": "node ./node_modules/dotenv-cli/cli.js -e ../../.env -- prisma migrate dev",
    "prisma:migrate:deploy": "node ./node_modules/dotenv-cli/cli.js -e ../../.env -- prisma migrate deploy",
    "prisma:studio": "node ./node_modules/dotenv-cli/cli.js -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@prisma/client": "7.10.1",
    "@sumirevox/shared": "workspace:*",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "emojibase-data": "^18.0.0",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "prisma": "7.10.1",
    "wanakana": "^5.3.1",
    "@prisma/adapter-pg": "7.10.1"
  },
  "optionalDependencies": {
    "@discordjs/opus": "^0.10.0",
    "sodium-native": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "dotenv-cli": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
