{
  "name": "sumirevox",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev:bot": "pnpm --filter @sumirevox/bot dev",
    "dev:api": "pnpm --filter @sumirevox/api dev",
    "dev:web": "pnpm --filter @sumirevox/web dev",
    "dev:admin": "pnpm --filter @sumirevox/admin dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "deploy-commands": "pnpm --filter @sumirevox/bot deploy-commands",
    "dev:bot:1": "cross-env BOT_INSTANCE_ID=1 pnpm --filter @sumirevox/bot dev",
    "dev:bot:2": "cross-env BOT_INSTANCE_ID=2 pnpm --filter @sumirevox/bot dev",
    "dev:bot:3": "cross-env BOT_INSTANCE_ID=3 pnpm --filter @sumirevox/bot dev",
    "deploy-commands:1": "cross-env BOT_INSTANCE_ID=1 pnpm --filter @sumirevox/bot deploy-commands",
    "deploy-commands:2": "cross-env BOT_INSTANCE_ID=2 pnpm --filter @sumirevox/bot deploy-commands",
    "deploy-commands:3": "cross-env BOT_INSTANCE_ID=3 pnpm --filter @sumirevox/bot deploy-commands",
    "db:migrate:dev": "pnpm --filter @sumirevox/bot prisma:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @sumirevox/bot prisma:migrate:deploy",
    "db:studio": "pnpm --filter @sumirevox/bot prisma:studio",
    "db:generate": "pnpm --filter @sumirevox/bot prisma:generate",
    "setup": "bash scripts/setup-env.sh && pnpm install && pnpm db:generate",
    "stripe:test": "node scripts/stripe-test.mjs"
  },
  "pnpm": {
    "overrides": {
      "undici": "8.12.3",
      "discord.js>undici": "6.29.1",
      "@discordjs/rest>undici": "6.29.1",
      "tar": ">=7.5.22 <8",
      "@visx/curve": "4.0.0",
      "@visx/event": "4.0.0",
      "@visx/grid": "4.0.0",
      "@visx/group": "4.0.0",
      "@visx/point": "4.0.0",
      "@visx/responsive": "4.0.0",
      "@visx/scale": "4.0.0",
      "@visx/shape": "4.0.0",
      "@visx/vendor": "4.0.0",
      "youch": "4.1.1",
      "ws": "8.22.0"
    },
    "onlyBuiltDependencies": [
      "@discordjs/opus",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sodium-native"
    ]
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "wrangler": "4.152.0"
  }
}
